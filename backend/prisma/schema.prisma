generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

model Application {
  id                Int      @id @default(autoincrement())
  fullName          String
  email             String   @unique
  phone             String
  areaOfInterest    String
  mentorshipFocus   String
  bio               String
  status            Status   @default(PENDING)
  submittedAt       DateTime @default(now())
}